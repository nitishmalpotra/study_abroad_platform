GOOGLE_API_KEY=your_google_api_key_here

# Optional runtime settings
APP_ENV=prod
SOP_DB_PATH=sop_app.db
SOP_MIN_WORDS=100
SOP_MAX_WORDS=2500
SOP_MAX_UPLOAD_MB=10
SOP_MAX_CHARS=30000
SOP_LLM_RETRIES=2
SOP_LLM_RETRY_BACKOFF_SEC=1.5
SOP_RATE_LIMIT_COUNT=6
SOP_RATE_LIMIT_WINDOW_MIN=60
SOP_GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-3-flash-preview

# Required AI provider configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional comma-separated fallback order. If set, it overrides DEEPSEEK_MODEL.
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional runtime settings
APP_ENV=development
LLM_TIMEOUT_SECONDS=45
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=1.0
LOG_LEVEL=INFO

# Optional compatibility guard used by the current app bootstrap logic
SOP_REQUIRE_ACCESS_TOKEN=false
SOP_APP_ACCESS_TOKEN=

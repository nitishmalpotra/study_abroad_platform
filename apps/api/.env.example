DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional locally. Required in production; use the pooled Neon connection string.
# DATABASE_URL=your_neon_postgres_connection_string_with_sslmode_require
API_PERSISTENCE_ENABLED=false

API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_LIVE_RATE_LIMIT_COUNT=6
API_LIVE_RATE_LIMIT_WINDOW_SECONDS=3600
API_MAX_REQUEST_BODY_BYTES=64000
# Keep false unless a trusted reverse proxy strips untrusted forwarding headers.
API_TRUST_PROXY_HEADERS=false

# Use memory for simple local development. Use postgres in production.
API_RATE_LIMIT_STORE=memory
# Required when API_RATE_LIMIT_STORE=postgres; do not commit a real value.
# API_RATE_LIMIT_HASH_SALT=replace_with_random_secret

# Optional future upload retention only. The public API currently does not use Blob.
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
